<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders NowPlayingBar to PNGs in a few states/sizes for visual checks outside SDR#. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\plugin\SDRSharp.HDRadio\NowPlayingBar.cs" Link="NowPlayingBar.cs" />
    <Compile Include="..\..\plugin\SDRSharp.HDRadio\BrandMark.cs" Link="BrandMark.cs" />
    <Compile Include="..\..\plugin\SDRSharp.HDRadio\HdDecoder.cs" Link="HdDecoder.cs" />
    <Compile Include="..\..\plugin\SDRSharp.HDRadio\Native.cs" Link="Native.cs" />
    <Compile Include="..\..\plugin\SDRSharp.HDRadio\Channelizer.cs" Link="Channelizer.cs" />
    <Compile Include="..\..\plugin\SDRSharp.HDRadio\AudioInjector.cs" Link="AudioInjector.cs" />
    <Compile Include="..\stresstest\SdrSharpStubs.cs" Link="SdrSharpStubs.cs" />
  </ItemGroup>
</Project>
